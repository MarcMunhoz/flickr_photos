    "express": "^4.18.2",
    "follow-redirects": "^1.14.7",
    "less": "^4.6.7",
    "less-loader": "^10.0.0",
    "node-fetch": "^3.3.2",
    "terser": "^5.49.0",
    "tmp": "^0.2.4",
    "vue": "^3.5.39",
    "vue-router": "^4.0.0-0"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.6",
